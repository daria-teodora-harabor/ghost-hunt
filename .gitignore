build/
dist/
.venv/
# results/ holds multi-GB weight dumps and per-tensor triage JSON — ignored.
# Exclude the *contents*, not the directory: git cannot re-include a file whose
# parent directory is itself excluded, and the small sweep tables below are part
# of the experimental record.
results/*
!results/phase1-sweep/
results/phase1-sweep/*
!results/phase1-sweep/*.jsonl
!results/phase1-sweep/*.md
!results/population/
results/population/*
!results/population/*.json
# 1.7B ENGINEERING qualification: small tables + verdicts + the pinned config that
# produced them. Not evidence for anything; see its PROVENANCE.md.
!results/qualification-1p7b/
results/qualification-1p7b/*
!results/qualification-1p7b/*.jsonl
!results/qualification-1p7b/*.json
!results/qualification-1p7b/*.yaml
!results/qualification-1p7b/*.md
