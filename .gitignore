__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
# results/ holds multi-GB weight dumps and per-tensor triage JSON — ignored.
# Exclude the *contents*, not the directory: git cannot re-include a file whose
# parent directory is itself excluded, and the small sweep tables below are part
# of the experimental record.
results/*
!results/phase1-sweep/
results/phase1-sweep/*
!results/phase1-sweep/*.jsonl
!results/phase1-sweep/*.md
!results/population/
results/population/*
!results/population/*.json
# 1.7B ENGINEERING qualification: small tables + verdicts + the pinned config that
# produced them. Not evidence for anything; see its PROVENANCE.md.
!results/qualification-1p7b/
results/qualification-1p7b/*
!results/qualification-1p7b/*.jsonl
!results/qualification-1p7b/*.json
!results/qualification-1p7b/*.yaml
!results/qualification-1p7b/*.md
!results/ladder/
results/ladder/*
!results/ladder/*.json
# Helpful/unhelpful contrast-probe control run: layer sweep table, chosen probe
# (small — a direction + scaler, not a checkpoint), visualization, provenance.
!results/control-helpful-unhelpful/
results/control-helpful-unhelpful/*
!results/control-helpful-unhelpful/*.json
!results/control-helpful-unhelpful/*.md
!results/control-helpful-unhelpful/*.png
!results/control-helpful-unhelpful/*.npz
# Superseded by the 16-question robust HHH set (generalization_robust_hhh.*): this
# first 6-question novel-wording attempt was weaker evidence (smaller, single-concept,
# degenerate perfect-1.0 CI) and is kept only in local/branch history, not published.
results/control-helpful-unhelpful/generalization_novel_questions.json
results/control-helpful-unhelpful/generalization_novel_questions.png
*.safetensors
*.gguf
.DS_Store

# Research pipeline outputs: adapters, cached activations, probes, candidate pools.
# These are large and regenerable from configs + seeds.
artifacts/
